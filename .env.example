# Copy this file to .env and fill in real values.
# .env itself is git-ignored and should never be committed.

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/vibes

# JWT signing secret - generate your own random string, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Server
PORT=4000

# Frontend URL (used for building links in emails and eSewa redirects)
FRONTEND_URL=http://localhost:3000

# eSewa payment gateway (RC/test environment credentials)
ESEWA_SECRET_KEY=
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# This backend's own public base URL (used for eSewa success/failure callback URLs)
APP_BASE_URL=http://localhost:4000

# Groq API (AI assistant chat widget) - get a free key at console.groq.com
GROQ_API_KEY=

# Gmail SMTP (password reset emails) - requires a Gmail App Password, not your normal password
# See: https://myaccount.google.com/apppasswords
EMAIL_USER=
EMAIL_APP_PASSWORD=